@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <p>@ViewBag.MensajeError</p>
    <form action="@Url.Action("VerificarSesion", "Home")" method="post" onsubmit="return VerificarSesion()">
        <input type="text" name="nombreUsuario" id="nombreUsuario" placeholder="Nombre de usuario">
        <input type="password" name="password" id="password" placeholder="Contraseña">
        <input type="submit" value="Iniciar sesión">
    </form>
    <p id = "error"></p>
    No tenes cuanta? <a href="@Url.Action("Registro", "Home")">Crea una cuenta aca</a>
</div>