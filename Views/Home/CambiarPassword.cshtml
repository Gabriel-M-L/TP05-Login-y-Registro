@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="login-card card shadow-sm">
    <div class="card-body">
        <h1 class="h3 text-center text-gradient mb-4">Cambiar Contraseña</h1>
        <div class="alert alert-warning">@ViewBag.MensajeError</div>
        
        <form action="@Url.Action("CambiarPassword", "Home")" method="post" onsubmit="return ValidarContrasenas()">
            <input type="hidden" name="usuarioId" value="@ViewBag.UsuarioId">
            
            <div class="mb-3">
                <p class="form-label">Nueva Contraseña</p>
                <input type="password" class="form-control" name="nuevoPassword" id="nuevoPassword" placeholder="Ingresa tu nueva contraseña" required>
            </div>
            
            <div class="mb-3">
                <p class="form-label">Confirmar Contraseña</p>
                <input type="password" class="form-control" name="confirmarPassword" id="confirmarPassword" placeholder="Confirma tu nueva contraseña" required>
            </div>
            
            <div id="errorPassword" style="display:none;" class="alert alert-danger"></div>
            
            <button type="submit" class="btn btn-primary w-100">Cambiar Contraseña</button>
        </form>
        
        <p class="text-center mt-3 mb-0"><a href="@Url.Action("Login", "Home")">Volver a Iniciar sesión</a></p>
    </div>
</div>
